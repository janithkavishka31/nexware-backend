# Copy to .env and fill in values (never commit .env)
#
# ── EC2 / production (Neon PostgreSQL) ───────────────────────────────────────
# Use these when running: docker compose up -d --build
#
NEON_DB_HOST=ep-xxxx.region.aws.neon.tech
NEON_DB_PORT=5432
NEON_DB_NAME=nexware
NEON_DB_USERNAME=your_neon_user
NEON_DB_PASSWORD=your_neon_password
NEON_DB_SSL_MODE=require
NEON_DB_CHANNEL_BINDING=require

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-secure-base64-or-hex-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Redis — set REDIS_ENABLED=false if not running Redis on EC2
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka — set KAFKA_ENABLED=false on small EC2 instances without Kafka
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Reservation scheduler (cron — default every 5 minutes)
RESERVATION_EXPIRY_CRON=0 */5 * * * *

# Application
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# Swagger / OpenAPI — use https in production (fixes Swagger calling http behind Nginx)
NEXWARE_OPENAPI_SERVER_URL=https://nexware.me
NEXWARE_OPENAPI_FORCE_HTTPS=true

# CORS (comma-separated frontend origins — add your Vercel deployment URL)
CORS_ALLOWED_ORIGINS=https://nexware-frontend.vercel.app,https://app.nexware.me,http://localhost:3000,http://localhost:5173

# Optional connection pool tuning
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ── Local Docker stack override ──────────────────────────────────────────────
# When using docker-compose.local.yml, replace the values above with:
#
# NEON_DB_HOST=postgres
# NEON_DB_SSL_MODE=disable
# NEON_DB_CHANNEL_BINDING=disable
# NEON_DB_USERNAME=nexware
# NEON_DB_PASSWORD=nexware_local
# REDIS_HOST=redis
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092
#
# Command:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
